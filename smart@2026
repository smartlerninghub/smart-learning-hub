<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin – Smart Learning Hub</title>
  <link rel="stylesheet" href="style.css">
  <style>
    body { background: #f3f6fa; }
    .admin-container {
      max-width: 1100px;
      margin: 40px auto;
      padding: 0 20px;
    }
    .admin-card {
      background: white;
      border-radius: 16px;
      padding: 28px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    }
    .login-box {
      max-width: 400px;
      margin: 80px auto;
      text-align: center;
    }
    .login-box input {
      width: 100%;
      padding: 12px 14px;
      margin: 12px 0 18px;
      border: 1px solid #d0d7e2;
      border-radius: 10px;
      font-size: 1rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      font-size: 0.92rem;
    }
    th, td {
      padding: 12px 10px;
      text-align: left;
      border-bottom: 1px solid #e5eaf0;
    }
    th {
      background: #f0f4f9;
      font-weight: 700;
      color: #123765;
    }
    tr:hover td { background: #f8fafc; }
    .status {
      margin-top: 12px;
      font-weight: 600;
    }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .badge {
      background: #e8f0fe;
      color: #123765;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="admin-container">

    <!-- LOGIN SCREEN -->
    <div id="loginScreen" class="admin-card login-box">
      <h2>Admin Login</h2>
      <p style="color:#637084">Enter the admin password to view registrations</p>
      <input type="password" id="adminPassword" placeholder="Enter password" />
      <button class="button button-primary" id="loginBtn" style="width:100%">Login</button>
      <p id="loginError" class="status" style="color:#c0392b"></p>
    </div>

    <!-- DASHBOARD -->
    <div id="dashboard" class="admin-card" style="display:none">
      <div class="top-bar">
        <div>
          <h2 style="margin:0">Student Registrations</h2>
          <p style="margin:6px 0 0; color:#637084">Smart Learning Hub Admin</p>
        </div>
        <div style="display:flex; gap:10px; align-items:center">
          <span class="badge" id="totalCount">0 registrations</span>
          <button class="button button-outline" id="refreshBtn">Refresh</button>
          <button class="button button-primary" id="logoutBtn">Logout</button>
        </div>
      </div>

      <div style="overflow-x:auto">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Student Name</th>
              <th>Guardian</th>
              <th>Phone</th>
              <th>Email</th>
              <th>Level</th>
              <th>Mode</th>
              <th>Subjects</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody id="registrationsBody">
            <tr><td colspan="9">Loading...</td></tr>
          </tbody>
        </table>
      </div>
      <p id="loadStatus" class="status"></p>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="supabase-config.js"></script>
  <script>
    // ===== CHANGE THIS PASSWORD =====
    const ADMIN_PASSWORD = "smart2026";   // ← change to your own password
    // =================================

    const loginScreen = document.getElementById("loginScreen");
    const dashboard = document.getElementById("dashboard");
    const loginBtn = document.getElementById("loginBtn");
    const loginError = document.getElementById("loginError");
    const passwordInput = document.getElementById("adminPassword");
    const registrationsBody = document.getElementById("registrationsBody");
    const totalCount = document.getElementById("totalCount");
    const loadStatus = document.getElementById("loadStatus");

    function getClient() {
      const url = window.SMART_LEARNING_HUB_SUPABASE_URL;
      const key = window.SMART_LEARNING_HUB_SUPABASE_KEY;
      if (!window.supabase || !url || !key) return null;
      return window.supabase.createClient(url, key);
    }

    async function loadRegistrations() {
      const client = getClient();
      if (!client) {
        loadStatus.textContent = "Database not configured.";
        return;
      }

      loadStatus.textContent = "Loading...";
      const { data, error } = await client
        .from("student_registrations")
        .select("*")
        .order("created_at", { ascending: false });

      if (error) {
        console.error(error);
        loadStatus.textContent = "Error loading data: " + error.message;
        registrationsBody.innerHTML = `<tr><td colspan="9">Failed to load</td></tr>`;
        return;
      }

      totalCount.textContent = `${data.length} registration${data.length !== 1 ? "s" : ""}`;
      loadStatus.textContent = "";

      if (data.length === 0) {
        registrationsBody.innerHTML = `<tr><td colspan="9">No registrations yet</td></tr>`;
        return;
      }

      registrationsBody.innerHTML = data.map((row, i) => `
        <tr>
          <td>${i + 1}</td>
          <td><strong>${row.student_name || "-"}</strong></td>
          <td>${row.guardian_name || "-"}</td>
          <td>${row.phone || "-"}</td>
          <td>${row.email || "-"}</td>
          <td>${row.level || "-"}</td>
          <td>${row.learning_mode || "-"}</td>
          <td>${row.subjects || "-"}</td>
          <td>${row.created_at ? new Date(row.created_at).toLocaleString("en-KE") : "-"}</td>
        </tr>
      `).join("");
    }

    // Login
    loginBtn.addEventListener("click", () => {
      if (passwordInput.value === ADMIN_PASSWORD) {
        sessionStorage.setItem("slh_admin", "true");
        loginScreen.style.display = "none";
        dashboard.style.display = "block";
        loadRegistrations();
      } else {
        loginError.textContent = "Wrong password";
      }
    });

    passwordInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") loginBtn.click();
    });

    // Logout
    document.getElementById("logoutBtn").addEventListener("click", () => {
      sessionStorage.removeItem("slh_admin");
      location.reload();
    });

    // Refresh
    document.getElementById("refreshBtn").addEventListener("click", loadRegistrations);

    // Auto-login if already logged in
    if (sessionStorage.getItem("slh_admin") === "true") {
      loginScreen.style.display = "none";
      dashboard.style.display = "block";
      loadRegistrations();
    }
  </script>
</body>
</html>
